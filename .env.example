# Copy this file to ".env" (same folder as app.py) and fill in YOUR key. Never commit ".env".
GEMINI_API_KEY=your_api_key_here
# Verified against https://ai.google.dev/gemini-api/docs/models on 2026-10-29 (stable, recommended for new projects).
# Alternatives listed there: gemini-3.8-flash (stronger), gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional tuning
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_RETRIES=2
# GEMINI_MAX_OUTPUT_TOKENS=1500
# LOW_CONFIDENCE_THRESHOLD=0.60
# MIN_TOP2_MARGIN=0.15
